{
  "name": "agorapp_backend",
  "version": "1.0.0",
  "description": "Aplicación para la creación, visualización y administración de reportes ciudadanos, con sistema de roles, gestión de organizaciones y seguimiento del estado de cada incidente.",
  "license": "ISC",
  "author": "Carlos Reynoso",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "dev:api": "tsx watch ./src/index.ts --api",
    "build": "tsc",
    "start": "node ./dist/index.js",
    "migrate": "tsx ./src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "@huggingface/inference": "^4.13.11",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "axios": "^1.13.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "openai": "^6.16.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.4",
    "zod": "^4.3.5"
  },
  "overrides": {
    "firebase-admin": {
      "@google-cloud/storage": "^8.0.1"
    }
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "@google/genai@2.17.1": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true
  }
}
